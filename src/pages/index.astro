---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Terminal from '../components/Terminal.astro';

const notes = (await getCollection('notes')).sort(
  (a, b) => Number(a.data.sample) - Number(b.data.sample)
    || b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
    || b.data.sequence - a.data.sequence,
);
const learningNotes = notes.filter((note) => !note.data.sample);
const recentNotes = (learningNotes.length ? learningNotes : notes).slice(0, 2);
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="从这里开始" description="面向初学者的 CTF 学习笔记与代码片段。" activeSection="home">
  <section class="hero">
    <div class="hero-intro">
      <p class="eyebrow">$ cat ./README</p>
      <h1>个人 CTF<br />学习日志<span class="terminal-cursor" aria-hidden="true">_</span></h1>
      <p class="hero-copy">记录概念、解题过程和实用脚本。先理解原理，再动手验证，把每次练习留下的线索整理在这里。</p>
      <div class="hero-actions">
        <a class="button button-primary" href={baseUrl + 'notes/'}>进入学习笔记 <span aria-hidden="true">→</span></a>
        <a class="text-link" href={baseUrl + 'snippets/'}>[ 查看代码片段 ]</a>
      </div>
    </div>
    <Terminal count={learningNotes.length || notes.length} notes={(learningNotes.length ? learningNotes : notes).map((note) => ({ title: note.data.title, url: baseUrl + 'notes/' + note.id + '/' }))} />
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div><p class="eyebrow">$ ls ./topics</p><h2>从这些基础开始</h2></div>
      <a class="text-link" href={baseUrl + 'notes/'}>全部笔记 <span aria-hidden="true">→</span></a>
    </div>
    <div class="path-grid">
      <a class="path-card" href={baseUrl + 'notes/ctf-first-steps/'}>
        <span class="card-index">[01]</span><span class="card-icon" aria-hidden="true">./</span>
        <h3>认识 CTF</h3><p>了解常见赛制、题目类型，以及安全练习的边界。</p><span class="card-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="path-card" href={baseUrl + 'notes/linux-basics/'}>
        <span class="card-index">[02]</span><span class="card-icon" aria-hidden="true">$_</span>
        <h3>Linux 基础</h3><p>熟悉目录、文件、权限和终端里的常用操作。</p><span class="card-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="path-card" href={baseUrl + 'snippets/'}>
        <span class="card-index">[03]</span><span class="card-icon" aria-hidden="true">&lbrace; &rbrace;</span>
        <h3>小工具箱</h3><p>收集解题时常用的短小脚本，边用边理解。</p><span class="card-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="section-block recent-block">
    <div class="section-heading">
      <div><p class="eyebrow">$ tail ./notes</p><h2>最近更新</h2></div>
      <a class="text-link" href={baseUrl + 'notes/'}>阅读全部 <span aria-hidden="true">→</span></a>
    </div>
    <div class="note-list">
      {recentNotes.map((note) => (
        <a class="note-row" href={baseUrl + 'notes/' + note.id + '/'}>
          <div><h3>{note.data.title}</h3><p>{note.data.description}</p></div>
          <time datetime={note.data.pubDate.toISOString()}>{note.data.pubDate.toISOString().slice(0, 10)}</time>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
