---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<BaseLayout title={note.data.title} description={note.data.description} activeSection="notes">
  <article class="article">
    <a class="back-link" href={import.meta.env.BASE_URL + 'notes/'}>← 返回学习笔记</a>
    <header class="article-header">
      <div class="tag-row">
        {note.data.category && <span class="tag">{note.data.category}</span>}
        {note.data.platform && <span class="tag">{note.data.platform}</span>}
        {note.data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
      <h1>{note.data.title}</h1><p>{note.data.description}</p>
      <time datetime={note.data.pubDate.toISOString()}>{note.data.pubDate.toISOString().slice(0, 10)}</time>
      {note.data.status && <p class="record-status">{note.data.status}</p>}
    </header>
    <div class="prose"><Content /></div>
    {note.data.sourceTitle && (
      <p class="source-credit">
        来源：{note.data.sourceTitle}
        {note.data.importedAt && <span> · 同步于 {note.data.importedAt.toISOString().slice(0, 10)}</span>}
      </p>
    )}
    <a class="back-link article-back" href={import.meta.env.BASE_URL + 'notes/'}>← 返回全部笔记</a>
  </article>
</BaseLayout>
